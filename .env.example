# ─────────────────────────────────────────────────────────────────────────────
# Environment Configuration
# Copy this file to .env (local dev) and fill in real values.
# NEVER commit .env or .env.test — they are in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Neon / Postgres ──────────────────────────────────────────────────────────
# Three Neon branches are used across environments:
#   main   → production (managed by Vercel environment variables)
#   dev    → local development (use in .env)
#   test   → CI E2E tests (use in .env.test, set as GitHub secrets)
#
# Create branches via https://console.neon.tech > your project > Branches.

# Pooler URL — used by Prisma client at runtime (wajib)
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Direct URL — used by Prisma CLI for schema push / migrations (wajib)
DIRECT_URL=postgresql://user:pass@ep-xxx.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# ─── Auth ────────────────────────────────────────────────────────────────────
# JWT signing secret — generate dengan: openssl rand -base64 32 (wajib)
JWT_SECRET=replace-this-with-a-unique-random-secret-before-running

# ─── Seed ────────────────────────────────────────────────────────────────────
# Default passwords untuk seeded accounts (opsional, default: Miracle2026!)
SEED_ADMIN_PASSWORD=
SEED_CAPTAIN_PASSWORD=

# ─── E2E Safety Guard ────────────────────────────────────────────────────────
# Set this in .env.test to the HOSTNAME ONLY of your Neon PRODUCTION branch.
# The E2E preflight will block the test run if DATABASE_URL points to this host.
# Find it in: Neon Console > your project > Branches > main > Connection string (pooling OFF)
# Example: ep-sparkling-night-azr6wxwd.c-3.ap-southeast-1.aws.neon.tech
NEON_PROD_HOST=ep-your-production-branch-host.c-3.ap-southeast-1.aws.neon.tech

# --- Public visual system + AI event art ---
FEATURE_FLAG_PUBLIC_VISUAL_V2=false
FEATURE_FLAG_AI_EVENT_ART=false
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2

# ─── Site base URL ────────────────────────────────────────────────────────────
# Absolute base URL used for metadata, sitemap.xml, robots.txt, OG images, and
# certificate generation (src/app/[locale]/layout.tsx, sitemap.ts, robots.ts,
# certificate/generate.ts, and event pages). Falls back to the production
# vercel.app URL if unset — set this explicitly once a custom domain is live.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Password reset email (Resend) ───────────────────────────────────────────
# Absolute base URL used to build the reset link sent by email (wajib untuk link reset yang valid).
# Separate from NEXT_PUBLIC_BASE_URL above — both must be updated together when the domain changes.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Set to true once RESEND_API_KEY below is configured, to actually send reset emails
# instead of just logging them to the console.
FEATURE_FLAG_EMAIL_PASSWORD_RESET=false
# API key from https://resend.com (free tier: 100 emails/day, no card required).
RESEND_API_KEY=
# Sender address. Without a verified domain in Resend, use the sandbox address below —
# it only delivers to the email that owns the Resend account. Once a custom domain is
# verified in Resend, switch this to an address on that domain (e.g. no-reply@yourdomain.com).
RESEND_FROM_EMAIL=onboarding@resend.dev

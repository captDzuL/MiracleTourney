# Neon / Postgres
# Pooler URL — used by Prisma client at runtime (wajib)
DATABASE_URL=postgresql://user:pass@ep-xxx.pooler.neon.tech/dbname?sslmode=require

# Direct URL — used by Prisma CLI for schema push (wajib)
DIRECT_URL=postgresql://user:pass@ep-xxx.neon.tech/dbname?sslmode=require

# JWT signing secret — generate dengan: openssl rand -base64 32 (wajib)
JWT_SECRET=replace-this-with-a-unique-random-secret-before-running

# Default passwords untuk seeded accounts (opsional, default: Miracle2026!)
SEED_ADMIN_PASSWORD=
SEED_CAPTAIN_PASSWORD=

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String               @id @default(cuid())
  email                String               @unique
  name                 String
  role                 String
  passwordHash         String
  tempPassword         String?
  deactivatedAt        DateTime?
  organizedEvents      Event[]              @relation("EventOrganizer")
  captainOf            Team[]               @relation("TeamCaptain")
  passwordResetTokens  PasswordResetToken[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}

model Event {
  id                   String             @id @default(cuid())
  slug                 String             @unique
  name                 String
  description          String
  logoUrl              String?
  gameImageUrl         String?
  gameId               String
  gameModeId           String
  format               String
  status               String
  participantCap       Int
  registrationWindow   String
  startsAt             String
  venue                String
  organizerUserId      String?
  organizer            User?              @relation("EventOrganizer", fields: [organizerUserId], references: [id], onDelete: SetNull)
  organizerName        String?
  organizerVerified    Boolean            @default(false)
  prizePoolLabel       String?
  registrationFeeLabel String?
  registrationUrl      String?
  characterArtUrl      String?
  accentColor          String?
  stream               EventStream?
  teams                Team[]
  matches              Match[]
  players              Player[]
  statSubmissions      StatSubmission[]
  roundConfigs         EventRoundConfig[]
  certificate          Certificate?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model EventStream {
  id       String  @id @default(cuid())
  eventId  String  @unique
  event    Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  platform String
  url      String
  label    String
  enabled  Boolean @default(true)
  isLive   Boolean @default(false)
}

model Team {
  id             String        @id @default(cuid())
  eventId        String
  event          Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  captainId      String?
  captain        User?         @relation("TeamCaptain", fields: [captainId], references: [id], onDelete: SetNull)
  name           String
  logoText       String
  logoUrl        String?
  tag            String
  captainName    String?
  captainContact String?
  source         String        @default("demo")
  players        Player[]
  certificates   Certificate[]
  createdAt      DateTime      @default(now())

  @@unique([eventId, tag])
  @@unique([eventId, name])
}

model Player {
  id           String       @id @default(cuid())
  teamId       String
  team         Team         @relation(fields: [teamId], references: [id], onDelete: Cascade)
  eventId      String
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  displayName  String
  nickname     String
  position     String
  jerseyNumber Int?
  stats        PlayerStat[]
  createdAt    DateTime     @default(now())

  @@unique([teamId, nickname])
}

model Match {
  id              String           @id @default(cuid())
  eventId         String
  event           Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  roundLabel      String
  homeTeamId      String
  awayTeamId      String
  homeScore       Int              @default(0)
  awayScore       Int              @default(0)
  status          String           @default("Scheduled")
  slot            Int?
  round           Int?
  winnerTeamId    String?
  scheduledLabel  String?
  playerStats     PlayerStat[]
  statSubmissions StatSubmission[]
  games           MatchGame[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@unique([eventId, round, slot])
}

model EventRoundConfig {
  id         String @id @default(cuid())
  eventId    String
  roundLabel String
  bestOf     Int    @default(1)
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, roundLabel])
}

model MatchGame {
  id         String @id @default(cuid())
  matchId    String
  gameNumber Int
  homeScore  Int
  awayScore  Int
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, gameNumber])
}

model PlayerStat {
  id         String @id @default(cuid())
  matchId    String
  match      Match  @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId   String
  player     Player @relation(fields: [playerId], references: [id], onDelete: Cascade)
  playerName String
  teamId     String
  position   String
  gameSlug   String
  stats      Json

  @@unique([matchId, playerId])
}

model StatSubmission {
  id            String    @id @default(cuid())
  matchId       String
  match         Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  teamId        String
  eventId       String
  event         Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  submittedBy   String
  status        String    @default("pending")
  rejectionNote String?
  stats         Json
  submittedAt   DateTime  @default(now())
  reviewedAt    DateTime?
  reviewedBy    String?

  @@unique([matchId, teamId])
}

model Certificate {
  id        String   @id @default(cuid())
  eventId   String   @unique
  teamId    String
  imageUrl  String
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  team      Team     @relation(fields: [teamId], references: [id])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
